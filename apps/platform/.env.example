# Segevision Platform — local environment.
#
# Copy this file to apps/platform/.env.local and fill in the values. Next.js reads
# .env.local from the app directory, so it belongs beside this file and nowhere else.
# .env.local is gitignored; this file is not, so it must never hold a real secret.
#
#   cp apps/platform/.env.example apps/platform/.env.local
#
# Changing any NEXT_PUBLIC_ value requires a restart: Next inlines them into the client
# and middleware bundles at build time, so a running server keeps the old value.

# ---------------------------------------------------------------------------
# Supabase — required
# ---------------------------------------------------------------------------
# Both come from the Supabase dashboard: Project Settings -> API.
# Public by design. They are inlined into the browser bundle, and that is safe: the
# publishable key grants nothing on its own, and Row Level Security is what protects the
# data. See supabase/migrations/ for the policies that do the protecting.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Storage backend — required in production
# ---------------------------------------------------------------------------
# supabase = projects in Postgres, media in Supabase Storage. The production setting.
# file     = projects and media under the repo-root .data directory. Local development
#            and disaster recovery only.
#
# Unset defaults to `file` in development and is refused outright in production, because
# a serverless filesystem accepts every write and loses it at the next cold start. There
# is no fallback in either direction: if Supabase is unreachable the app returns a 503
# rather than quietly writing somewhere temporary.
PROJECT_STORE=supabase

# ---------------------------------------------------------------------------
# Migration script — never needed by the app
# ---------------------------------------------------------------------------
# scripts/migrate-local-projects-to-supabase.ts signs in as the account that will own the
# migrated projects, so every write goes through the same RLS policies the app uses. Pass
# these on the command line for the one run instead of storing them here:
#
#   SUPABASE_MIGRATION_EMAIL=you@example.com SUPABASE_MIGRATION_PASSWORD=... \
#     pnpm migrate:projects -- --execute
#
# SUPABASE_MIGRATION_EMAIL=
# SUPABASE_MIGRATION_PASSWORD=

# No SUPABASE_SERVICE_ROLE_KEY anywhere. It bypasses RLS, and nothing in this repo needs
# it — not the app, not the migration. If a future script genuinely does, it belongs in
# that script's environment for that one run and never in a file or in Vercel.

# ---------------------------------------------------------------------------
# Local filesystem paths — optional, PROJECT_STORE=file only
# ---------------------------------------------------------------------------
# Absolute path overrides for the local adapter. Also the signal that makes
# PROJECT_STORE=file permissible in production: setting it asserts that a real mounted
# volume exists.
# SEGEVISION_DATA_ROOT=
# SEGEVISION_DATA_DIR=
# SEGEVISION_MEDIA_DIR=
